--- /dev/null
+++ b/src/bovary-stream.h
@@ -0,0 +1,390 @@
+#pragma once
+
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "gguf.h"
+#include "llama-impl.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+// Path-valued environment variables must survive non-UTF-8 Windows code pages.
+inline std::string bovary_stream_path_environment(const char * name) {
+#ifdef _WIN32
+    const std::wstring wide_name(name, name + std::strlen(name));
+    const DWORD capacity = GetEnvironmentVariableW(wide_name.c_str(), nullptr, 0);
+    if (capacity == 0) return {};
+    std::wstring value(capacity, L'\0');
+    const DWORD length = GetEnvironmentVariableW(wide_name.c_str(), value.data(), capacity);
+    if (length == 0 || length >= capacity) throw std::runtime_error("path environment changed while being read");
+    const int bytes = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, value.data(), static_cast<int>(length), nullptr, 0, nullptr, nullptr);
+    if (bytes == 0) throw std::runtime_error("path environment is not valid Unicode");
+    std::string result(bytes, '\0');
+    if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, value.data(), static_cast<int>(length), result.data(), bytes, nullptr, nullptr) != bytes)
+        throw std::runtime_error("cannot convert path environment to UTF-8");
+    return result;
+#else
+    const char * value = std::getenv(name);
+    return value ? value : "";
+#endif
+}
+
+inline bool bovary_stream_enabled() {
+    const char * value = std::getenv("BOVARY_STREAM");
+    return value && std::strcmp(value, "1") == 0;
+}
+
+inline bool bovary_stream_expert(const std::string & name) {
+    return name.find("_exps.weight") != std::string::npos;
+}
+
+struct bovary_stream_counters {
+    uint64_t requested_bytes = 0;
+    uint64_t io_bytes = 0;
+    uint64_t read_calls = 0;
+    uint64_t read_ns = 0;
+    uint64_t upload_wait_ns = 0;
+};
+
+// The mapped expert weights provide tensor metadata only. Reads use this bounded pool.
+struct bovary_stream_reader : bovary_stream_counters {
+    bovary_stream_counters snapshot() const { return *this; }
+#ifdef _WIN32
+    size_t capacity = 8 * 1024 * 1024;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    void * buffer = nullptr;
+    size_t alignment = 4096;
+    size_t file_size = 0;
+    bool direct = false;
+    bool pinned2 = false;
+    size_t host_bytes = 0;
+    size_t pinned_bytes = 0;
+    ggml_backend_t transfer_backend = nullptr;
+    struct transfer_slot {
+        ggml_backend_buffer_ptr allocation;
+        ggml_backend_event_ptr event;
+        uint8_t * data = nullptr;
+        size_t usable = 0;
+        bool pending = false;
+    };
+    std::array<transfer_slot, 2> slots;
+    size_t next_slot = 0;
+    struct weight { size_t offset; size_t size; ggml_type type; };
+    std::unordered_map<std::string, weight> weights;
+    struct packed_layer { size_t offset, stride, gate_up, down; };
+    std::unordered_map<std::string, packed_layer> packed_layers;
+    size_t packed_experts = 0;
+
+    bool packed() const { return !packed_layers.empty(); }
+
+    size_t initialize_packed_layout(const gguf_context * meta) {
+        const int64_t layer_key = gguf_find_key(meta, "inkling2_loop.block_count");
+        const int64_t expert_key = gguf_find_key(meta, "inkling2_loop.expert_count");
+        if (layer_key < 0 || expert_key < 0 ||
+                gguf_get_kv_type(meta, layer_key) != GGUF_TYPE_UINT32 ||
+                gguf_get_kv_type(meta, expert_key) != GGUF_TYPE_UINT32) {
+            throw std::runtime_error("packed streaming requires an Inkling 2 loop GGUF");
+        }
+        const size_t layers = gguf_get_val_u32(meta, layer_key);
+        packed_experts = gguf_get_val_u32(meta, expert_key);
+        if (layers != 24 || packed_experts != 128 || weights.size() != 2 * layers) {
+            throw std::runtime_error("packed streaming requires the Inkling 2 Mini fused expert layout");
+        }
+        size_t offset = 0;
+        for (size_t layer = 0; layer < layers; ++layer) {
+            const std::string stem = "blk." + std::to_string(layer) + ".ffn_";
+            const std::string gate_name = stem + "gate_up_exps.weight";
+            const auto & gate = weights.at(gate_name);
+            const auto & down = weights.at(stem + "down_exps.weight");
+            if (gate.size % packed_experts || down.size % packed_experts) {
+                throw std::runtime_error("packed tensor size is not divisible by expert count");
+            }
+            const size_t gate_bytes = gate.size / packed_experts;
+            const size_t down_bytes = down.size / packed_experts;
+            const size_t stride = GGML_PAD(gate_bytes + down_bytes, 4096);
+            if (stride > (SIZE_MAX - offset) / packed_experts) {
+                throw std::runtime_error("packed streaming layout overflows file offsets");
+            }
+            packed_layers.emplace(gate_name, packed_layer { offset, stride, gate_bytes, down_bytes });
+            offset += packed_experts * stride;
+        }
+        return offset;
+    }
+
+    bovary_stream_reader(ggml_backend_t backend) {
+        if (const char * value = std::getenv("BOVARY_STREAM_BUFFER_MIB")) {
+            char * end = nullptr;
+            const unsigned long mib = std::strtoul(value, &end, 10);
+            if (!*value || *end || mib < 1 || mib > 64) {
+                throw std::runtime_error("BOVARY_STREAM_BUFFER_MIB must be an integer from 1 to 64");
+            }
+            capacity = static_cast<size_t>(mib) * 1024 * 1024;
+        }
+        if (const char * pool = std::getenv("BOVARY_STREAM_POOL"); pool && *pool) {
+            if (std::strcmp(pool, "pinned2") == 0) pinned2 = true;
+            else if (std::strcmp(pool, "serial") != 0)
+                throw std::runtime_error("BOVARY_STREAM_POOL must be serial or pinned2");
+        }
+        if (pinned2 && capacity > 8 * 1024 * 1024)
+            throw std::runtime_error("pinned2 accepts at most 8 MiB per slot, 16 MiB total");
+        const std::string path = bovary_stream_path_environment("BOVARY_STREAM_MODEL");
+        if (path.empty()) {
+            throw std::runtime_error("BOVARY_STREAM_MODEL must name the loaded single GGUF");
+        }
+        gguf_init_params params = { true, nullptr };
+        std::unique_ptr<gguf_context, decltype(&gguf_free)> meta(gguf_init_from_file(path.c_str(), params), gguf_free);
+        if (!meta) {
+            throw std::runtime_error("cannot read streaming GGUF metadata");
+        }
+        for (int64_t i = 0; i < gguf_get_n_tensors(meta.get()); ++i) {
+            const std::string name = gguf_get_tensor_name(meta.get(), i);
+            if (bovary_stream_expert(name)) {
+                const size_t base = gguf_get_data_offset(meta.get());
+                const size_t offset = gguf_get_tensor_offset(meta.get(), i);
+                if (offset > SIZE_MAX - base) {
+                    throw std::runtime_error("streaming tensor offset overflow");
+                }
+                weights.emplace(name, weight { base + offset, gguf_get_tensor_size(meta.get(), i), gguf_get_tensor_type(meta.get(), i) });
+            }
+        }
+        const char * mode = std::getenv("BOVARY_STREAM_IO");
+        direct = mode && std::strcmp(mode, "unbuffered") == 0;
+        if (mode && *mode && std::strcmp(mode, "unbuffered") && std::strcmp(mode, "buffered")) {
+            throw std::runtime_error("BOVARY_STREAM_IO must be buffered or unbuffered");
+        }
+        const std::string sidecar = bovary_stream_path_environment("BOVARY_STREAM_PACKED");
+        const size_t packed_size = sidecar.empty() ? 0 : initialize_packed_layout(meta.get());
+        file = CreateFileW(std::filesystem::u8path(sidecar.empty() ? path : sidecar).c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+                          FILE_ATTRIBUTE_NORMAL | FILE_FLAG_RANDOM_ACCESS | (direct ? FILE_FLAG_NO_BUFFERING : 0), nullptr);
+        if (file == INVALID_HANDLE_VALUE) {
+            throw std::runtime_error("cannot open streaming weights, Win32 error " + std::to_string(GetLastError()));
+        }
+        LARGE_INTEGER size;
+        FILE_STORAGE_INFO storage = {};
+        if (!GetFileSizeEx(file, &size) || size.QuadPart < 0 ||
+            !GetFileInformationByHandleEx(file, FileStorageInfo, &storage, sizeof(storage))) {
+            CloseHandle(file);
+            file = INVALID_HANDLE_VALUE;
+            throw std::runtime_error("cannot query streaming file size/sector alignment");
+        }
+        file_size = static_cast<size_t>(size.QuadPart);
+        alignment = std::max<size_t>({ 4096, storage.PhysicalBytesPerSectorForPerformance,
+            storage.PhysicalBytesPerSectorForAtomicity, storage.LogicalBytesPerSector,
+            storage.FileSystemEffectivePhysicalBytesPerSectorForAtomicity });
+        if (alignment > 65536 || (alignment & (alignment - 1))) {
+            CloseHandle(file);
+            file = INVALID_HANDLE_VALUE;
+            throw std::runtime_error("unsupported streaming sector alignment");
+        }
+        if (packed() && (file_size != packed_size || (direct && alignment != 4096))) {
+            CloseHandle(file);
+            file = INVALID_HANDLE_VALUE;
+            throw std::runtime_error("packed stream length or device alignment does not match its GGUF layout");
+        }
+        if (packed()) {
+            for (const auto & item : packed_layers) {
+                if (item.second.stride > capacity || pinned2) {
+                    CloseHandle(file);
+                    file = INVALID_HANDLE_VALUE;
+                    throw std::runtime_error("Inkling packed streaming requires a serial buffer of at least 9 MiB");
+                }
+            }
+        } else {
+            for (const auto & item : weights) {
+                if (item.second.offset <= file_size && item.second.size <= file_size - item.second.offset) continue;
+                CloseHandle(file);
+                file = INVALID_HANDLE_VALUE;
+                throw std::runtime_error("streaming tensor outside GGUF file");
+            }
+        }
+        try {
+            if (pinned2) {
+                initialize_pinned_pool(backend);
+            } else {
+                buffer = VirtualAlloc(nullptr, capacity, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+                if (!buffer) throw std::runtime_error("cannot allocate bounded streaming buffer");
+                host_bytes = capacity;
+            }
+        } catch (...) {
+            CloseHandle(file);
+            file = INVALID_HANDLE_VALUE;
+            throw;
+        }
+        LLAMA_LOG_INFO("bovary_stream: %s %s I/O, pool=%s host_buffer_bytes=%zu pinned_bytes=%zu host_buffer_slots=%d host_slot_bytes=%zu sector_alignment=%zu\n",
+                       packed() ? "packed" : "GGUF", direct ? "unbuffered" : "buffered", pinned2 ? "pinned2" : "serial",
+                       host_bytes, pinned_bytes, pinned2 ? 2 : 1, capacity, alignment);
+    }
+
+    void initialize_pinned_pool(ggml_backend_t backend) {
+        if (!backend) throw std::runtime_error("pinned2 requires a GPU backend");
+        const auto device = ggml_backend_get_device(backend);
+        ggml_backend_dev_props props;
+        ggml_backend_dev_get_props(device, &props);
+        const auto host_type = ggml_backend_dev_host_buffer_type(device);
+        if (!props.caps.async || !props.caps.host_buffer || !props.caps.events || !host_type)
+            throw std::runtime_error("pinned2 requires asynchronous GPU uploads, pinned host buffers and events");
+        transfer_backend = backend;
+        for (auto & slot : slots) {
+            slot.allocation.reset(ggml_backend_buft_alloc_buffer(host_type, capacity));
+            if (!slot.allocation || ggml_backend_buffer_get_type(slot.allocation.get()) != host_type)
+                throw std::runtime_error("pinned2 host allocation failed or fell back to unpinned memory");
+            const size_t actual = ggml_backend_buffer_get_size(slot.allocation.get());
+            const auto base = reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(slot.allocation.get()));
+            if (!base || actual > capacity) throw std::runtime_error("pinned2 returned invalid or oversized host allocation");
+            const size_t padding = (alignment - base % alignment) % alignment;
+            if (actual <= padding + alignment) throw std::runtime_error("pinned2 host allocation has no aligned payload capacity");
+            slot.data = reinterpret_cast<uint8_t *>(base + padding);
+            slot.usable = ((actual - padding) / alignment) * alignment;
+            slot.event.reset(ggml_backend_event_new(device));
+            if (!slot.event) throw std::runtime_error("pinned2 could not create transfer completion event");
+            host_bytes += actual;
+            pinned_bytes += actual;
+        }
+    }
+
+    void wait_slot(transfer_slot & slot) {
+        if (!slot.pending) return;
+        const auto start = std::chrono::steady_clock::now();
+        ggml_backend_event_synchronize(slot.event.get());
+        upload_wait_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count();
+        slot.pending = false;
+    }
+
+    void finish() {
+        if (pinned2) for (auto & slot : slots) wait_slot(slot);
+    }
+
+    void upload_packed(ggml_backend_t backend, const std::vector<ggml_tensor *> & banks,
+            const std::vector<ggml_tensor *> & tensors, size_t expert, size_t destination) {
+        GGML_ASSERT(banks.size() == 2 && tensors.size() == 2 && expert < packed_experts);
+        if (pinned2 && backend != transfer_backend) GGML_ABORT("pinned2 supports one GPU upload backend");
+        size_t gate = 0;
+        auto it = packed_layers.find(tensors[gate]->name);
+        if (it == packed_layers.end()) it = packed_layers.find(tensors[++gate]->name);
+        if (it == packed_layers.end()) GGML_ABORT("missing packed gate/up tensor");
+        const size_t down = 1 - gate;
+        const packed_layer & layer = it->second;
+        if (tensors[gate]->nb[2] != layer.gate_up || tensors[down]->nb[2] != layer.down) {
+            GGML_ABORT("packed expert dimensions do not match the live tensors");
+        }
+        transfer_slot * slot = nullptr;
+        auto * read_buffer = static_cast<uint8_t *>(buffer);
+        size_t usable = capacity;
+        if (pinned2) {
+            slot = &slots[next_slot];
+            next_slot = (next_slot + 1) % slots.size();
+            wait_slot(*slot);
+            read_buffer = slot->data;
+            usable = slot->usable;
+        }
+        if (layer.stride > usable) GGML_ABORT("packed streaming buffer is smaller than an expert record; use serial with at least 9 MiB");
+        LARGE_INTEGER position;
+        position.QuadPart = layer.offset + layer.stride * expert;
+        DWORD received = 0;
+        const auto read_start = std::chrono::steady_clock::now();
+        if (!SetFilePointerEx(file, position, nullptr, FILE_BEGIN) ||
+            !ReadFile(file, read_buffer, static_cast<DWORD>(layer.stride), &received, nullptr) ||
+            received != layer.stride) {
+            GGML_ABORT("packed streaming ReadFile failed or short read, error %lu", GetLastError());
+        }
+        read_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - read_start).count();
+        ++read_calls;
+        io_bytes += received;
+        requested_bytes += layer.gate_up + layer.down;
+        const auto upload_start = std::chrono::steady_clock::now();
+        ggml_backend_tensor_set_async(backend, banks[gate], read_buffer, destination * layer.gate_up, layer.gate_up);
+        ggml_backend_tensor_set_async(backend, banks[down], read_buffer + layer.gate_up, destination * layer.down, layer.down);
+        if (slot) {
+            ggml_backend_event_record(slot->event.get(), backend);
+            slot->pending = true;
+        } else {
+            ggml_backend_synchronize(backend);
+        }
+        upload_wait_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - upload_start).count();
+    }
+
+    ~bovary_stream_reader() {
+        finish();
+        LLAMA_LOG_INFO("bovary_stream: read_calls=%llu requested_bytes=%llu io_bytes=%llu read_ns=%llu upload_wait_ns=%llu pool=%s host_buffer_bytes=%zu pinned_bytes=%zu\n",
+                       (unsigned long long) read_calls, (unsigned long long) requested_bytes,
+                       (unsigned long long) io_bytes, (unsigned long long) read_ns,
+                       (unsigned long long) upload_wait_ns, pinned2 ? "pinned2" : "serial", host_bytes, pinned_bytes);
+        if (buffer) { VirtualFree(buffer, 0, MEM_RELEASE); }
+        if (file != INVALID_HANDLE_VALUE) { CloseHandle(file); }
+    }
+
+    void upload(ggml_backend_t backend, ggml_tensor * bank, const ggml_tensor * tensor,
+                size_t source_offset, size_t destination_offset, size_t length) {
+        if (pinned2 && backend != transfer_backend) GGML_ABORT("pinned2 supports one GPU upload backend");
+        const auto it = weights.find(tensor->name);
+        if (it == weights.end() || it->second.type != tensor->type || it->second.size != ggml_nbytes(tensor) ||
+            source_offset > it->second.size || length > it->second.size - source_offset) {
+            GGML_ABORT("invalid streaming source tensor or range: %s", tensor->name);
+        }
+        requested_bytes += length;
+        size_t done = 0;
+        while (done < length) {
+            transfer_slot * slot = nullptr;
+            auto * read_buffer = static_cast<uint8_t *>(buffer);
+            size_t usable = capacity;
+            if (pinned2) {
+                slot = &slots[next_slot];
+                next_slot = (next_slot + 1) % slots.size();
+                wait_slot(*slot);
+                read_buffer = slot->data;
+                usable = slot->usable;
+            }
+            const size_t offset = it->second.offset + source_offset + done;
+            const size_t head = direct ? offset % alignment : 0;
+            const size_t count = std::min(length - done, usable - alignment);
+            const size_t total = direct ? ((head + count + alignment - 1) / alignment) * alignment : count;
+            LARGE_INTEGER position;
+            position.QuadPart = offset - head;
+            DWORD received = 0;
+            const auto start = std::chrono::steady_clock::now();
+            if (!SetFilePointerEx(file, position, nullptr, FILE_BEGIN) ||
+                !ReadFile(file, read_buffer, static_cast<DWORD>(total), &received, nullptr) || received < head + count) {
+                GGML_ABORT("streaming ReadFile failed or short read, error %lu", GetLastError());
+            }
+            read_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count();
+            ++read_calls;
+            io_bytes += received;
+            // Serial times enqueue plus completion. Pinned2 times enqueue and residual event waits, not DMA duration.
+            const auto upload_start = std::chrono::steady_clock::now();
+            ggml_backend_tensor_set_async(backend, bank, read_buffer + head, destination_offset + done, count);
+            if (slot) {
+                ggml_backend_event_record(slot->event.get(), backend);
+                slot->pending = true;
+            } else {
+                ggml_backend_synchronize(backend);
+            }
+            upload_wait_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - upload_start).count();
+            done += count;
+        }
+    }
+#else
+    bovary_stream_reader(ggml_backend_t) { throw std::runtime_error("BOVARY_STREAM requires Windows"); }
+    bool packed() const { return false; }
+    void upload_packed(ggml_backend_t, const std::vector<ggml_tensor *> &,
+            const std::vector<ggml_tensor *> &, size_t, size_t) {}
+    void upload(ggml_backend_t, ggml_tensor *, const ggml_tensor *, size_t, size_t, size_t) {}
+    void finish() {}
+#endif
+};
