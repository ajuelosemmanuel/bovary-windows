          "sha256": "4c6bf590b8a9bf28bc58a159786203818b39aca6eece7f5e8f639fa99224c4e7"
        }
      },
      "fix": "Launch the actual base interpreter, flush its PID before readiness, assert PID equals Popen.pid, then kill/wait for that owner. No lock retries, file deletion or runtime changes.",
      "runtime_changed": false
